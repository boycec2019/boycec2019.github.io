---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const projects = (await getCollection('projects')).sort(
  (first, second) => first.data.order - second.data.order || first.id.localeCompare(second.id),
);
---

<SiteLayout
  title="Boyce Chow | Electrical Engineering Portfolio"
  description="Boyce Chow is an electrical engineering undergraduate at UC Irvine. Explore his PCB design, embedded systems, and power electronics projects."
>
  <main id="main" tabindex="-1" class="site-width pb-16">
    <div class="pt-10 pb-8">
      <h1 class="text-5xl leading-none font-semibold tracking-[-0.07em] sm:text-6xl lg:text-[4.5rem]">
        Boyce Chow
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-copy sm:text-lg">
        Hello and welcome to my portfolio! My name is Boyce, and I'm an electrical engineering student at UC Irvine. Please feel free to check out some of my projects!
      </p>
    </div>

    <section id="projects" aria-labelledby="projects-title" class="scroll-mt-5">
      <div class="mb-4 flex items-center gap-4">
        <h2 id="projects-title" class="text-2xl font-semibold tracking-tight">Projects</h2>
        <div aria-hidden="true" class="h-px grow bg-line"></div>
      </div>
      <ul class="grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))] gap-5" role="list">
        {projects.map((project) => (
          <li class="min-w-0">
            <ProjectCard project={project} />
          </li>
        ))}
      </ul>
    </section>
  </main>
</SiteLayout>
